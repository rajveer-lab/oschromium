{
  "manifest_version": 3,
  "name": "Smart Tab Saver",
  "version": "1.1.0",
  "description": "Keeps only the tabs you need awake, using a policy learned from Belady's optimal algorithm, plus task focus, predictive wake, away and handoff, green mode and call mode.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "system.memory",
    "system.cpu",
    "idle",
    "offscreen",
    "tabGroups"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Tab Saver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
